# Campaign-local regenerable/private payloads
campaigns/*/results/**/cache/
campaigns/*/results/**/checkpoints/
campaigns/*/results/**/local/
campaigns/*/results/**/raw_data/
campaigns/*/results/**/*.pid
campaigns/*/results/**/*.lock

# Keep protocols, console logs, scores, reports, and retrieval manifests trackable.
# Inspect actual staged content before publication; file names do not establish privacy.
